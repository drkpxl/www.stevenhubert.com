---
import Base from '../layouts/Base.astro';
---
<Base title="About" description="About Steven Hubert.">
  <section class="about">
    <div class="inset">

      <header class="head">
        <p class="eyebrow">About</p>
        <h1 class="title">Steven Hubert.</h1>
      </header>

      <div class="body">
        <p class="lead">
          Senior Director of Digital Experience at Alterra Mountain Company.
          I build the teams that ship the products sitting between a guest and
          a mountain. The Ikon Pass, mountain ecommerce, operations tools, and
          the apps the resorts run on.
        </p>

        <p>
          Twenty years across agency and in-house work. Earlier stops at
          Mondo Robot, Crispin Porter + Bogusky, and Domani Studios. Five
          Cannes Gold lions across that span. Based in Denver.
        </p>

        <p>
          The long version of the CV lives on
          <a href="https://www.linkedin.com/in/stevenhubert/" rel="noopener" target="_blank">LinkedIn ↗</a>,
          which is also the best way to reach me.
        </p>
      </div>

    </div>
  </section>
</Base>

<style>
  .inset {
    max-width: var(--layout-max);
    margin: 0 auto;
    padding-inline: var(--layout-inset);
  }
  .about {
    padding-block: clamp(48px, 7vw, 96px) clamp(48px, 6vw, 80px);
  }

  .head {
    display: grid;
    gap: 14px;
    margin-bottom: clamp(36px, 5vw, 60px);
    padding-bottom: clamp(24px, 4vw, 36px);
    border-bottom: 1px solid var(--color-rule-strong);
    max-width: 56rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-soft);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--type-h1);
    line-height: 1.02;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .body {
    max-width: var(--measure);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .body p {
    font-size: var(--type-body);
    line-height: 1.65;
    color: var(--color-ink);
  }
  .body .lead {
    font-size: var(--type-lede);
    line-height: 1.45;
    color: var(--color-ink);
  }
  .body a {
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-alpen);
    padding-bottom: 1px;
    transition: color 180ms ease;
  }
  .body a:hover { color: var(--color-alpen); }
</style>
