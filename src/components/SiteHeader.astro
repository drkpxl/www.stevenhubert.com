---
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <div class="inset">
    <a href="/" class="brand" aria-label="Steven Hubert — home">
      <span class="brand__name">Steven Hubert</span>
      <span class="brand__role">Digital Experience · Alterra</span>
    </a>
    <nav aria-label="Primary">
      <a href="/work/" aria-current={isActive('/work') ? 'page' : undefined}>Work</a>
      <a href="/about/" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
      <a
        href="https://www.linkedin.com/in/stevenhubert/"
        rel="noopener"
        target="_blank"
      >
        LinkedIn <span class="external" aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
  <div class="rule rule--alpen"></div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-paper);
  }
  .inset {
    max-width: var(--layout-max);
    margin: 0 auto;
    padding: 18px var(--layout-inset);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    color: var(--color-ink);
    text-decoration: none;
  }
  .brand__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: var(--tracking-brand);
    text-transform: uppercase;
  }
  .brand__role {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 13px;
    color: var(--color-ink-soft);
  }
  nav {
    display: flex;
    gap: 24px;
    align-items: baseline;
  }
  nav a {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color 180ms ease;
  }
  nav a:hover { color: var(--color-ink); }
  nav a[aria-current='page'] {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-alpen);
    text-underline-offset: 0.4em;
    text-decoration-thickness: 1px;
  }
  nav a .external {
    font-family: var(--font-body);
    font-size: 0.95em;
  }

  @media (max-width: 480px) {
    .inset { gap: 12px; }
    .brand { flex-direction: column; gap: 4px; align-items: flex-start; }
    .brand__role { font-size: 12px; }
    nav { gap: 18px; }
  }
</style>
