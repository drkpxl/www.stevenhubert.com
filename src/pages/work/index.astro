---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const signature = all.filter((e) => e.data.tier === '1');
const selected = all.filter((e) => e.data.tier === '2');
---
<Base title="Work" description="Selected work by Steven Hubert.">
  <section class="page">
    <div class="inset">
      <header class="page-head">
        <p class="eyebrow">Index of Work</p>
        <h1 class="title">
          <em>Twenty years</em>, in selected fragments.
        </h1>
        <p class="standfirst">
          A working index. Live products, archive pieces, agency campaigns,
          and the occasional moonshot. Dateless on purpose.
        </p>
      </header>

      {signature.length > 0 && (
        <section class="tier" data-tier="1">
          <h2 class="tier__title">Signature work.</h2>
          <div class="grid grid--feature">
            {signature.map((entry, i) => (
              <WorkCard entry={entry} index={i} variant="feature" />
            ))}
          </div>
        </section>
      )}

      {selected.length > 0 && (
        <section class="tier" data-tier="2">
          <h2 class="tier__title">Selected work.</h2>
          <div class="list">
            {selected.map((entry, i) => (
              <WorkCard entry={entry} index={i} variant="entry" />
            ))}
          </div>
        </section>
      )}
    </div>
  </section>
</Base>

<style>
  .inset {
    max-width: var(--layout-max);
    margin-inline: auto;
    padding-inline: var(--layout-inset);
  }
  .page {
    padding-block: clamp(var(--space-7), 7vw, var(--space-9)) var(--space-8);
  }

  .page-head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-ink);
    max-width: 56rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-soft);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--type-h1);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
  }
  .title em { font-style: italic; }
  .standfirst {
    margin-top: var(--space-3);
    font-size: var(--type-lede);
    line-height: var(--leading-snug);
    color: var(--color-ink-soft);
    max-width: 48ch;
  }

  .tier + .tier {
    margin-top: var(--space-10);
  }
  .tier__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    margin-bottom: var(--space-7);
  }

  .grid--feature {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--space-7);
    row-gap: var(--space-8);
  }
  .list {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--color-rule);
  }

  @media (max-width: 880px) {
    .grid--feature {
      grid-template-columns: 1fr;
      row-gap: var(--space-7);
    }
  }
</style>
