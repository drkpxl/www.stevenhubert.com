---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';

const all = await getCollection('work');
const featured = all
  .filter((e) => e.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const lead = featured[0];
const list = featured.slice(1, 6);
const totalCount = all.length;
---
<Base title="Steven Hubert">
  <section class="hero" aria-labelledby="name">
    <div class="inset">
      <h1 id="name" class="name">
        Steven<span class="second">Hubert</span>
      </h1>

      <div class="standfirst">
        <p>
          Senior Director of Digital Experience at Alterra Mountain Company.
          I lead product, design, and content strategy for the company behind
          the Ikon Pass and fifteen mountain resorts.
        </p>
        <p class="aside">
          Twenty years across agency, in-house, and personal product work.
          Denver, Colorado. <a href="https://www.linkedin.com/in/stevenhubert/" rel="noopener" target="_blank">LinkedIn ↗</a> for everything else.
        </p>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="work" aria-labelledby="selected-head">
      <div class="inset">
        <header class="work__head">
          <h2 id="selected-head">Selected work</h2>
          <span class="work__meta">{totalCount} entries</span>
        </header>

        {lead && (
          <article class="lead">
            <a class="lead__media" href={`/work/${lead.id}/`} aria-label={lead.data.title}>
              {lead.data.heroImage && <img src={lead.data.heroImage} alt="" loading="eager" />}
            </a>
            <div class="lead__copy">
              <span class="lead__index">№ 01 · Lead feature</span>
              <h3 class="lead__title"><a href={`/work/${lead.id}/`}>{lead.data.title}</a></h3>
              <p class="lead__excerpt">{lead.data.excerpt}</p>
              <a class="lead__read" href={`/work/${lead.id}/`}>
                Read the case study
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        )}

        {list.length > 0 && (
          <nav class="list" aria-label="More featured work">
            {list.map((entry, i) => (
              <WorkCard entry={entry} index={i + 1} variant="entry" />
            ))}
          </nav>
        )}

        <a class="see-all" href="/work/">
          Full index of {totalCount} entries
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )}
</Base>

<style>
  .inset {
    max-width: var(--layout-max);
    margin: 0 auto;
    padding-inline: var(--layout-inset);
  }

  /* Hero ----------------------------------------------------------- */
  .hero {
    padding-block: clamp(48px, 7vw, 96px) clamp(48px, 6vw, 80px);
  }
  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--type-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--color-ink);
    max-width: 12ch;
  }
  .name .second { display: block; }

  .standfirst {
    margin-top: clamp(28px, 4vw, 44px);
    max-width: 52ch;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .standfirst p {
    font-family: var(--font-body);
    font-size: var(--type-lede);
    line-height: 1.45;
    color: var(--color-ink);
  }
  .standfirst p.aside {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-ink-soft);
    max-width: 46ch;
  }
  .standfirst a {
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-alpen);
    transition: color 180ms ease;
  }
  .standfirst a:hover { color: var(--color-alpen); }

  /* Work section --------------------------------------------------- */
  .work__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 18px;
    border-top: 1px solid var(--color-rule-strong);
    border-bottom: 1px solid var(--color-rule);
    gap: 24px;
    flex-wrap: wrap;
  }
  .work__head h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.25rem, 2.4vw, 1.55rem);
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-ink);
  }
  .work__meta {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-soft);
    text-transform: uppercase;
  }

  /* Lead feature --------------------------------------------------- */
  .lead {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(24px, 4vw, 56px);
    row-gap: 28px;
    padding-block: clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--color-rule);
    align-items: start;
  }
  .lead__media { display: block; }
  .lead__media img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--color-rule-strong);
    background: var(--color-paper-shade);
    transition: transform 480ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .lead__media:hover img { transform: scale(1.008); }
  .lead__copy { padding-top: 4px; }
  .lead__index {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--color-alpen);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    display: inline-block;
    margin-bottom: 14px;
  }
  .lead__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3rem);
    line-height: 1.02;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    color: var(--color-ink);
    max-width: 22ch;
  }
  .lead__title a { color: inherit; transition: color 180ms ease; }
  .lead__title a:hover { color: var(--color-alpen); }
  .lead__excerpt {
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-ink);
    max-width: 42ch;
  }
  .lead__read {
    margin-top: 22px;
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
    padding-bottom: 2px;
    transition: color 180ms ease, border-bottom-color 180ms ease;
  }
  .lead__read .arrow { color: var(--color-alpen); transition: transform 240ms ease; }
  .lead__read:hover { color: var(--color-alpen); border-bottom-color: var(--color-alpen); }
  .lead__read:hover .arrow { transform: translateX(4px); }

  /* List of more featured ----------------------------------------- */
  .list { display: flex; flex-direction: column; }

  /* See all -------------------------------------------------------- */
  .see-all {
    margin-top: clamp(32px, 5vw, 48px);
    padding-block: 16px;
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
    transition: color 180ms ease, border-bottom-color 180ms ease;
  }
  .see-all .arrow { color: var(--color-alpen); transition: transform 240ms ease; }
  .see-all:hover { color: var(--color-alpen); border-bottom-color: var(--color-alpen); }
  .see-all:hover .arrow { transform: translateX(4px); }

  @media (max-width: 820px) {
    .lead { grid-template-columns: 1fr; }
  }
</style>
