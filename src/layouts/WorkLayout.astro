---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, client, agency, role, excerpt, heroImage, tier, categories, externalUrl } = entry.data;
const isSignature = tier === '1';
const tierLabel = isSignature ? 'Signature work' : 'Selected work';
const hasAgency = Boolean(agency && client && agency !== client);
---
<Base title={title} description={excerpt}>
  <article class="work" data-layout="work" data-tier={tier}>
    <header class="work__head">
      <div class="inset">
        <div class="rubric">
          <a class="rubric__back" href="/work/">
            <span aria-hidden="true">←</span>
            <span>Index of work</span>
          </a>
          <span class="rubric__section">{tierLabel}</span>
        </div>

        <h1 class="title">{title}</h1>

        <div class="cover">
          <div class="cover__lede">
            <p class="standfirst">{excerpt}</p>
          </div>

          <aside class="brief" aria-label="At a glance">
            <p class="brief__label">A Brief</p>
            <dl class="brief__list">
              {client && (
                <div class="brief__row">
                  <dt>Client</dt>
                  <dd>{client}</dd>
                </div>
              )}
              {hasAgency && (
                <div class="brief__row">
                  <dt>Agency</dt>
                  <dd>{agency}</dd>
                </div>
              )}
              {role && (
                <div class="brief__row">
                  <dt>Role</dt>
                  <dd>{role}</dd>
                </div>
              )}
              {categories && categories.length > 0 && (
                <div class="brief__row">
                  <dt>Scope</dt>
                  <dd>{categories.join(' · ')}</dd>
                </div>
              )}
              {externalUrl && (
                <div class="brief__row">
                  <dt>Visit</dt>
                  <dd>
                    <a class="brief__link" href={externalUrl} rel="noopener" target="_blank">
                      Live site <span aria-hidden="true">↗</span>
                    </a>
                  </dd>
                </div>
              )}
            </dl>
          </aside>
        </div>
      </div>
    </header>

    <div class="body">
      <div class="prose">
        {heroImage && (
          <figure class="plate">
            <img src={heroImage} alt="" loading="lazy" />
          </figure>
        )}
        <slot />
      </div>
    </div>

    <footer class="work__foot">
      <div class="inset">
        <a class="next" href="/work/">
          <span class="next__label">Return to</span>
          <span class="next__title"><em>Index of work</em></span>
          <span class="next__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </footer>
  </article>
</Base>

<style>
  .inset {
    max-width: var(--layout-max);
    margin-inline: auto;
    padding-inline: var(--layout-inset);
  }

  .work {
    padding-bottom: var(--space-9);
  }

  /* Head ---------------------------------------------------------------- */

  .work__head {
    padding-block: var(--space-6) clamp(var(--space-8), 9vw, var(--space-10));
  }

  .rubric {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: clamp(var(--space-7), 7vw, var(--space-9));
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }
  .rubric__back {
    color: var(--color-ink-soft);
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    transition: color 180ms ease;
  }
  .rubric__back:hover {
    color: var(--color-ink);
  }
  .rubric__section {
    color: var(--color-ink);
  }

  .title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: var(--type-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    max-width: 16ch;
    margin-bottom: clamp(var(--space-8), 8vw, var(--space-9));
  }
  [data-tier='2'] .title {
    font-size: clamp(2.75rem, 6vw, 4.75rem);
    max-width: 20ch;
  }

  .cover {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    column-gap: clamp(var(--space-6), 6vw, var(--space-9));
    row-gap: var(--space-7);
    align-items: start;
  }

  .cover__lede {
    max-width: 48ch;
  }
  .standfirst {
    font-family: var(--font-body);
    font-size: var(--type-lede);
    line-height: var(--leading-snug);
    color: var(--color-ink);
  }

  /* Brief sidebar ------------------------------------------------------ */

  .brief {
    border-inline-start: 1px solid var(--color-rule);
    padding-inline-start: clamp(var(--space-5), 3vw, var(--space-7));
  }
  .brief__label {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-faint);
    margin-bottom: var(--space-4);
  }
  .brief__list { display: grid; gap: 0; }
  .brief__row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    column-gap: var(--space-4);
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-rule);
    align-items: baseline;
  }
  .brief__row:last-child {
    border-bottom: 1px solid var(--color-rule);
  }
  .brief__row dt {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-faint);
  }
  .brief__row dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--type-small);
    line-height: var(--leading-snug);
    color: var(--color-ink);
  }
  .brief__link {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    transition: color 180ms ease;
  }
  .brief__link:hover {
    color: var(--color-ink-soft);
  }

  /* Body ---------------------------------------------------------------- */

  .body {
    padding-block: clamp(var(--space-7), 7vw, var(--space-8)) var(--space-8);
    padding-inline: var(--layout-inset);
  }
  .body :global(.prose) {
    margin-inline: auto;
  }

  .body :global(.prose .plate) {
    margin: 0 0 var(--space-8);
  }
  .body :global(.prose .plate img) {
    width: 100%;
    height: auto;
    background: var(--color-paper-shade);
    margin: 0;
  }

  /* Foot ---------------------------------------------------------------- */

  .work__foot {
    margin-top: var(--space-9);
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-ink);
  }
  .next {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-5);
    align-items: baseline;
    text-decoration: none;
    color: var(--color-ink);
  }
  .next__label {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-soft);
  }
  .next__title {
    font-family: var(--font-display);
    font-size: clamp(var(--type-h3), 3.4vw, var(--type-h2));
    line-height: var(--leading-tight);
    color: var(--color-ink);
  }
  .next__title em { font-style: italic; }
  .next__arrow {
    font-size: 1.4rem;
    transition: transform 240ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .next:hover .next__arrow { transform: translateX(6px); }
  .next:hover .next__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  /* Responsive ---------------------------------------------------------- */

  @media (max-width: 820px) {
    .cover {
      grid-template-columns: 1fr;
      row-gap: var(--space-6);
    }
    .brief {
      border-inline-start: 0;
      padding-inline-start: 0;
      border-top: 1px solid var(--color-rule);
      padding-top: var(--space-6);
    }
  }

  @media (max-width: 600px) {
    .rubric {
      flex-direction: column;
      gap: var(--space-2);
      align-items: flex-start;
    }
    .next {
      grid-template-columns: 1fr auto;
    }
    .next__label { grid-column: 1; }
    .next__title { grid-column: 1; }
    .next__arrow {
      grid-row: 1 / span 2;
      grid-column: 2;
      align-self: center;
    }
  }
</style>
