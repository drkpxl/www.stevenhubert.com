---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="inset">
    <span class="col">© Steven Hubert · {year}</span>
    <span class="col col--place">Denver, CO · 1,609 m above sea</span>
    <span class="col col--reach">
      <a href="https://www.linkedin.com/in/stevenhubert/" rel="noopener" target="_blank">LinkedIn ↗</a>
      &nbsp;&nbsp;
      <a href="/work/">Index</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    padding: 24px 0 28px;
    border-top: 1px solid var(--color-rule);
  }
  .inset {
    max-width: var(--layout-max);
    margin: 0 auto;
    padding-inline: var(--layout-inset);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-soft);
    text-transform: uppercase;
  }
  .col a {
    color: var(--color-ink-soft);
    border-bottom: 1px solid var(--color-ink-faint);
    padding-bottom: 1px;
    transition: color 180ms ease, border-bottom-color 180ms ease;
  }
  .col a:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-alpen);
  }
  @media (max-width: 600px) {
    .inset { gap: 8px; flex-direction: column; align-items: flex-start; }
  }
</style>
