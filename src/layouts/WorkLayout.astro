---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, client, agency, role, excerpt, heroImage, tier, categories, externalUrl, stats } = entry.data;
const tierLabel = tier === '1' ? 'Signature' : 'Selected';
const hasAgency = Boolean(agency && client && agency !== client);
---
<Base title={title} description={excerpt}>
  <article class="post" data-tier={tier}>
    <div class="inset">

      <nav class="breadcrumb">
        <a href="/work/">← Index of work</a>
        <span class="pos">{tierLabel}</span>
      </nav>

      <section class="title-block">
        <h1 class="title">{title}</h1>
        <p class="standfirst">{excerpt}</p>

        <dl class="brief">
          {client && (
            <div class="brief__row">
              <dt>Client</dt>
              <dd>{client}</dd>
            </div>
          )}
          {hasAgency && (
            <div class="brief__row">
              <dt>Agency</dt>
              <dd>{agency}</dd>
            </div>
          )}
          {role && (
            <div class="brief__row">
              <dt>Role</dt>
              <dd>{role}</dd>
            </div>
          )}
          {categories && categories.length > 0 && (
            <div class="brief__row">
              <dt>Scope</dt>
              <dd>{categories.join(' · ')}</dd>
            </div>
          )}
          {externalUrl && (
            <div class="brief__row">
              <dt>Visit</dt>
              <dd>
                <a class="brief__link" href={externalUrl} rel="noopener" target="_blank">
                  Live site <span aria-hidden="true">↗</span>
                </a>
              </dd>
            </div>
          )}
        </dl>

        {stats && stats.length > 0 && (
          <div class="stats" aria-label="At a glance">
            {stats.map((s) => (
              <div class="stat">
                <div class="n">
                  {s.n}
                  {s.u && <span class="u">{s.u}</span>}
                </div>
                <div class="l">{s.l}</div>
                {s.d && <p class="d">{s.d}</p>}
              </div>
            ))}
          </div>
        )}
      </section>

      {heroImage && (
        <figure class="plate">
          <img src={heroImage} alt="" />
        </figure>
      )}

      <div class="body">
        <div class="prose">
          <slot />
        </div>
      </div>

    </div>
  </article>
</Base>

<style>
  .inset {
    max-width: var(--layout-max);
    margin: 0 auto;
    padding-inline: var(--layout-inset);
  }

  /* Breadcrumb ----------------------------------------------------- */
  .breadcrumb {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 28px 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-soft);
    text-transform: uppercase;
  }
  .breadcrumb a {
    border-bottom: 1px solid transparent;
    transition: border-color 180ms ease, color 180ms ease;
  }
  .breadcrumb a:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-alpen);
  }
  .breadcrumb .pos { color: var(--color-ink); }

  /* Title block ---------------------------------------------------- */
  .title-block { padding-block: 40px 32px; }

  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.96;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    color: var(--color-ink);
    max-width: 14ch;
  }
  .standfirst {
    margin-top: 28px;
    font-family: var(--font-body);
    font-size: var(--type-lede);
    line-height: 1.45;
    color: var(--color-ink);
    max-width: 48ch;
  }

  /* Brief --------------------------------------------------------- */
  .brief {
    margin-top: clamp(32px, 4vw, 48px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px 28px;
    padding-block: 20px;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    max-width: 62ch;
  }
  .brief__row {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .brief__row dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-faint);
  }
  .brief__row dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.4;
    color: var(--color-ink);
  }
  .brief__link {
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-alpen);
    padding-bottom: 1px;
    transition: color 180ms ease;
  }
  .brief__link:hover { color: var(--color-alpen); }

  /* Stats grid ---------------------------------------------------- */
  .stats {
    margin-top: clamp(28px, 4vw, 44px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(28px, 5vw, 64px);
    row-gap: 32px;
    max-width: 62ch;
  }
  .stat .n {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 4.5vw, 3rem);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-alpen);
    display: flex;
    align-items: baseline;
    gap: 2px;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .stat .n .u {
    font-size: 0.42em;
    color: var(--color-ink-soft);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 700;
    margin-left: 6px;
  }
  .stat .l {
    margin-top: 12px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.05rem, 1.6vw, 1.125rem);
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.25;
    color: var(--color-ink);
  }
  .stat .d {
    margin-top: 6px;
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-ink-soft);
    max-width: 30ch;
  }

  @media (max-width: 600px) {
    .stats { grid-template-columns: 1fr; row-gap: 24px; }
  }

  /* Hero plate ---------------------------------------------------- */
  .plate {
    margin-top: clamp(48px, 6vw, 72px);
    margin-bottom: clamp(48px, 6vw, 72px);
  }
  .plate img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--color-rule-strong);
    background: var(--color-paper-shade);
  }

  /* Body ---------------------------------------------------------- */
  .body {
    padding-bottom: var(--space-8);
  }
</style>
