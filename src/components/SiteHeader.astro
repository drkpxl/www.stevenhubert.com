---
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <div class="inset">
    <a href="/" class="wordmark" aria-label="Steven Hubert — home">
      <span class="wordmark__given">Steven</span>
      <span class="wordmark__family">Hubert</span>
    </a>
    <nav aria-label="Primary">
      <a href="/work/" aria-current={isActive('/work') ? 'page' : undefined}>
        <span>Work</span>
      </a>
      <a
        href="https://www.linkedin.com/in/stevenhubert/"
        rel="noopener"
        target="_blank"
      >
        <span>LinkedIn</span>
        <span class="external" aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-paper);
  }
  .inset {
    max-width: var(--layout-max);
    margin-inline: auto;
    padding: var(--space-5) var(--layout-inset);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .wordmark {
    color: var(--color-ink);
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    line-height: 1;
  }
  .wordmark__given {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.55rem;
    letter-spacing: var(--tracking-tight);
  }
  .wordmark__family {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  nav {
    display: flex;
    gap: var(--space-6);
    align-items: baseline;
  }
  nav a {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-soft);
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-ink);
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-ink);
    text-underline-offset: 0.4em;
    text-decoration-thickness: 1px;
  }
  nav a .external {
    font-family: var(--font-body);
    font-size: 0.9em;
  }

  @media (max-width: 480px) {
    .inset {
      gap: var(--space-3);
    }
    .wordmark__given {
      font-size: 1.35rem;
    }
    .wordmark__family {
      font-size: 0.95rem;
    }
    nav {
      gap: var(--space-5);
    }
  }
</style>
