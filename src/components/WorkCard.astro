---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  index?: number;
  variant?: 'feature' | 'entry';
}

const { entry, index, variant = 'feature' } = Astro.props;
const { title, client, excerpt, heroImage } = entry.data;
const href = `/work/${entry.id}/`;
const indexLabel = typeof index === 'number' ? String(index + 1).padStart(2, '0') : null;
---
{variant === 'entry' ? (
  <a class="entry" href={href}>
    {indexLabel && <span class="entry__num">№ {indexLabel}</span>}
    <div class="entry__body">
      <h3 class="entry__title">{title}</h3>
      {excerpt && <p class="entry__excerpt">{excerpt}</p>}
    </div>
    <span class="entry__arrow" aria-hidden="true">→</span>
  </a>
) : (
  <a class="feature" href={href}>
    {heroImage && (
      <div class="feature__thumb">
        <img src={heroImage} alt="" loading="lazy" />
      </div>
    )}
    <div class="feature__meta">
      <div class="feature__row">
        {indexLabel && <span class="feature__num">№ {indexLabel}</span>}
        {client && <span class="feature__client">{client}</span>}
      </div>
      <h3 class="feature__title">{title}</h3>
      {excerpt && <p class="feature__excerpt">{excerpt}</p>}
    </div>
  </a>
)}

<style>
  /* Feature variant — grid card with image */
  .feature {
    display: grid;
    gap: 16px;
    color: var(--color-ink);
    text-decoration: none;
  }
  .feature__thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-paper-shade);
    border: 1px solid var(--color-rule);
  }
  .feature__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 540ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .feature:hover .feature__thumb img { transform: scale(1.012); }

  .feature__row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-faint);
    font-variant-numeric: tabular-nums;
  }
  .feature__num { color: var(--color-alpen); }
  .feature__client { color: var(--color-ink-soft); }

  .feature__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.4vw, 1.85rem);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    color: var(--color-ink);
    margin-top: 4px;
    transition: color 180ms ease;
  }
  .feature:hover .feature__title { color: var(--color-alpen); }

  .feature__excerpt {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-ink-soft);
    max-width: 42ch;
  }

  /* Entry variant — numbered list row */
  .entry {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 1.5rem;
    column-gap: 24px;
    align-items: baseline;
    padding-block: 22px;
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink);
    text-decoration: none;
    transition: background 180ms ease;
  }
  .entry:hover { background: rgba(31, 85, 184, 0.03); }

  .entry__num {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-alpen);
    font-variant-numeric: tabular-nums;
  }
  .entry__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .entry__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.35rem, 2.6vw, 1.65rem);
    line-height: 1.15;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-ink);
  }
  .entry:hover .entry__title {
    text-decoration: underline;
    text-decoration-color: var(--color-alpen);
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }
  .entry__excerpt {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-ink-soft);
    max-width: 64ch;
  }
  .entry__arrow {
    color: var(--color-ink-faint);
    font-family: var(--font-mono);
    text-align: right;
    transition: transform 240ms ease, color 180ms ease;
  }
  .entry:hover .entry__arrow {
    color: var(--color-alpen);
    transform: translateX(4px);
  }

  @media (max-width: 600px) {
    .entry {
      grid-template-columns: 2.25rem 1fr 1.25rem;
      column-gap: 14px;
      padding-block: 18px;
    }
  }
</style>
