---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="inset">
    <div class="col col--name">
      <p class="label">Colophon</p>
      <p class="body">
        Set in <em>Instrument Serif</em> and Hanken Grotesk.
        Hand-built in Astro, served from Cloudflare.
      </p>
    </div>
    <div class="col col--contact">
      <p class="label">Reach</p>
      <p class="body">
        <a href="https://www.linkedin.com/in/stevenhubert/" rel="noopener" target="_blank">
          LinkedIn ↗
        </a>
      </p>
    </div>
    <div class="col col--mark">
      <p class="label">©</p>
      <p class="body">Steven Hubert, {year}.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-rule);
    margin-top: var(--space-9);
    padding: var(--space-7) 0 var(--space-6);
    color: var(--color-ink-soft);
  }
  .inset {
    max-width: var(--layout-max);
    margin-inline: auto;
    padding-inline: var(--layout-inset);
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-6);
    align-items: start;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .label {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-faint);
  }
  .body {
    font-family: var(--font-body);
    font-size: var(--type-small);
    line-height: var(--leading-snug);
    color: var(--color-ink-soft);
    max-width: 32ch;
  }
  .body em {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15em;
    color: var(--color-ink);
  }
  .col--contact .body a {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule-strong);
    padding-bottom: 0.12em;
  }
  .col--contact .body a:hover {
    border-bottom-color: var(--color-ink);
  }

  @media (max-width: 720px) {
    .inset {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
