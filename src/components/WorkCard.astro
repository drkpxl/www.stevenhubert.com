---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, client, excerpt, heroImage, externalUrl } = entry.data;
const href = externalUrl ?? `/work/${entry.id}/`;
const external = Boolean(externalUrl);
---
<a
  class="work-card"
  href={href}
  data-tier={entry.data.tier}
  data-featured={entry.data.featured ? '' : undefined}
  rel={external ? 'noopener' : undefined}
  target={external ? '_blank' : undefined}
>
  {heroImage && (
    <div class="thumb">
      <img src={heroImage} alt="" loading="lazy" />
    </div>
  )}
  <div class="meta">
    {client && <p class="client">{client}</p>}
    <h3>{title}</h3>
    <p class="excerpt">{excerpt}</p>
  </div>
</a>

<style>
  .work-card {
    display: block;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-3);
    overflow: hidden;
    background: var(--color-bg-elev);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }
  .work-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
  }
  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-border);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .meta {
    padding: var(--space-5);
  }
  .client {
    font-size: var(--type-2);
    color: var(--color-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }
  h3 {
    font-size: var(--type-4);
    margin: 0;
    line-height: var(--leading-snug);
  }
  .excerpt {
    margin-top: var(--space-3);
    color: var(--color-fg-muted);
    font-size: var(--type-2);
    line-height: var(--leading-snug);
  }
</style>
