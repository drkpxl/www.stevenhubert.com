---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';

const featured = (await getCollection('work', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const recent = featured[0];
const recentHref = recent ? `/work/${recent.id}/` : '/work/';
const recentTitle = recent?.data.title ?? 'See the work';
---
<Base title="Steven Hubert">
  <section class="intro" aria-labelledby="masthead-title">
    <div class="inset">
      <p class="dateline" data-stagger="1">
        <span class="dateline__label">Portfolio</span>
        <span class="dateline__sep" aria-hidden="true">·</span>
        <span class="dateline__value">Steven Hubert</span>
      </p>

      <h1 id="masthead-title" class="masthead">
        <span class="masthead__row" data-stagger="2">
          <span class="masthead__word masthead__word--italic">Steven</span>
        </span>
        <span class="masthead__row masthead__row--indent" data-stagger="3">
          <span class="masthead__word">Hubert.</span>
        </span>
      </h1>

      <div class="hero-row">
        <div class="standfirst" data-stagger="4">
          <p>
            Director of Digital Experience at Alterra Mountain Company.
            I lead product, design, and content strategy for the company
            behind the Ikon Pass and fifteen mountain resorts.
          </p>
          <p>
            Twenty years across agency, in-house, and personal product work.
            Best way to reach me is
            <a href="https://www.linkedin.com/in/stevenhubert/" rel="noopener" target="_blank">
              LinkedIn <span aria-hidden="true">↗</span>
            </a>.
          </p>
        </div>

        <aside class="brief" aria-label="At a glance" data-stagger="5">
          <p class="brief__label">A Brief</p>
          <dl class="brief__list">
            <div class="brief__row">
              <dt>Role</dt>
              <dd>Director, Digital Experience</dd>
            </div>
            <div class="brief__row">
              <dt>Company</dt>
              <dd>Alterra Mountain Company</dd>
            </div>
            <div class="brief__row">
              <dt>Scope</dt>
              <dd>Product · Design · Content strategy</dd>
            </div>
            <div class="brief__row">
              <dt>Place</dt>
              <dd>Denver, Colorado</dd>
            </div>
            <div class="brief__row">
              <dt>Years</dt>
              <dd>Twenty plus</dd>
            </div>
            <div class="brief__row">
              <dt>Recent</dt>
              <dd>
                <a href={recentHref}>
                  {recentTitle} <span aria-hidden="true">→</span>
                </a>
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="featured" aria-labelledby="featured-heading">
      <div class="inset">
        <header class="featured__head">
          <p class="eyebrow">§ Selected Work</p>
          <h2 id="featured-heading" class="featured__title">
            Four <em>recent</em> projects.
          </h2>
        </header>

        <div class="grid">
          {featured.map((entry, i) => (
            <WorkCard entry={entry} index={i} variant="feature" />
          ))}
        </div>

        <div class="see-all">
          <a href="/work/">
            Full index of work
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .inset {
    max-width: var(--layout-max);
    margin-inline: auto;
    padding-inline: var(--layout-inset);
  }

  /* Intro --------------------------------------------------------------- */

  .intro {
    padding-block: clamp(var(--space-7), 8vw, var(--space-9));
  }

  .dateline {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-soft);
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-7);
    border-bottom: 1px solid var(--color-ink);
    padding-right: var(--space-7);
  }
  .dateline__label {
    color: var(--color-ink-faint);
  }
  .dateline__sep {
    color: var(--color-ink-faint);
  }
  .dateline__value {
    color: var(--color-ink);
  }

  .masthead {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--type-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    margin-bottom: var(--space-7);
  }
  .masthead__row {
    display: block;
  }
  .masthead__row--indent {
    padding-inline-start: 1.6em;
  }
  .masthead__word {
    display: inline-block;
  }
  .masthead__word--italic {
    font-style: italic;
  }

  .hero-row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    column-gap: clamp(var(--space-6), 6vw, var(--space-9));
    row-gap: var(--space-7);
    align-items: start;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-rule);
  }

  .standfirst {
    max-width: 46ch;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .standfirst p {
    font-family: var(--font-body);
    font-size: var(--type-lede);
    line-height: var(--leading-snug);
    color: var(--color-ink);
  }
  .standfirst p:nth-child(2) {
    font-size: var(--type-body);
    color: var(--color-ink-soft);
    max-width: 42ch;
  }
  .standfirst a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-ink);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  /* Brief --------------------------------------------------------------- */

  .brief {
    border-inline-start: 1px solid var(--color-rule);
    padding-inline-start: clamp(var(--space-5), 3vw, var(--space-7));
  }
  .brief__label {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-faint);
    margin-bottom: var(--space-4);
  }
  .brief__list {
    display: grid;
    gap: 0;
  }
  .brief__row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    column-gap: var(--space-4);
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-rule);
    align-items: baseline;
  }
  .brief__row:last-child {
    border-bottom: 1px solid var(--color-rule);
  }
  .brief__row dt {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-faint);
  }
  .brief__row dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--type-small);
    line-height: var(--leading-snug);
    color: var(--color-ink);
  }
  .brief__row a {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule-strong);
    padding-bottom: 0.06em;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
  }
  .brief__row a:hover {
    border-bottom-color: var(--color-ink);
  }
  .brief__row a span {
    display: inline-block;
    transition: transform 240ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .brief__row a:hover span {
    transform: translateX(3px);
  }

  /* Featured ------------------------------------------------------------ */

  .featured {
    padding-block: var(--space-9) var(--space-8);
    border-top: 1px solid var(--color-ink);
  }
  .featured__head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);
    align-items: baseline;
    margin-bottom: var(--space-8);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-soft);
  }
  .featured__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--type-h1);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
  }
  .featured__title em {
    font-style: italic;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--space-7);
    row-gap: var(--space-8);
  }

  .see-all {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-rule);
  }
  .see-all a {
    font-family: var(--font-mono);
    font-size: var(--type-small);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink);
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .see-all a:hover span {
    transform: translateX(4px);
  }
  .see-all span {
    display: inline-block;
    transition: transform 240ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  /* Motion -------------------------------------------------------------- */

  [data-stagger] {
    opacity: 0;
    transform: translateY(8px);
    animation: rise 700ms cubic-bezier(0.2, 0.6, 0.2, 1) forwards;
  }
  [data-stagger='1'] { animation-delay: 40ms; }
  [data-stagger='2'] { animation-delay: 140ms; }
  [data-stagger='3'] { animation-delay: 260ms; }
  [data-stagger='4'] { animation-delay: 420ms; }
  [data-stagger='5'] { animation-delay: 560ms; }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-stagger] {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  /* Responsive ---------------------------------------------------------- */

  @media (max-width: 880px) {
    .grid {
      grid-template-columns: 1fr;
      row-gap: var(--space-7);
    }
  }

  @media (max-width: 820px) {
    .hero-row {
      grid-template-columns: 1fr;
      row-gap: var(--space-6);
    }
    .brief {
      border-inline-start: 0;
      padding-inline-start: 0;
      border-top: 1px solid var(--color-rule);
      padding-top: var(--space-6);
    }
  }

  @media (max-width: 720px) {
    .masthead__row--indent {
      padding-inline-start: 1em;
    }
    .featured__head {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
