---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="Page not found.">
  <section class="not-found">
    <div class="inset">
      <p class="code">404</p>
      <h1 class="title">
        <em>Off-piste.</em>
      </h1>
      <p class="body">
        That URL doesn't lead anywhere on the property. Head back to the
        <a href="/">homepage</a>, or browse the
        <a href="/work/">index of work</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .not-found {
    padding-block: clamp(var(--space-8), 12vw, var(--space-10));
  }
  .inset {
    max-width: var(--layout-max);
    margin-inline: auto;
    padding-inline: var(--layout-inset);
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .code {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-ink-soft);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--type-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    max-width: 14ch;
  }
  .title em {
    font-style: italic;
  }
  .body {
    font-size: var(--type-lede);
    line-height: var(--leading-snug);
    color: var(--color-ink-soft);
    max-width: var(--measure-narrow);
  }
  .body a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-ink);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
</style>
