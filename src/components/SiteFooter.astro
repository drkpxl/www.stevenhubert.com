---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <p>&copy; {year} Steven Hubert</p>
    <p>
      <a href="https://www.linkedin.com/in/stevenhubert/" rel="noopener" target="_blank">LinkedIn</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-9);
    padding: var(--space-6) 0;
    color: var(--color-fg-muted);
    font-size: var(--type-2);
  }
  .container {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-5);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .container a {
    color: var(--color-fg-muted);
  }
  .container a:hover {
    color: var(--color-fg);
  }
</style>
